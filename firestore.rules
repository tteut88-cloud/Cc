rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function coupleOf(cid) { return get(/databases/$(database)/documents/couples/$(cid)).data; }
    function isMember(cid) { return authed() && request.auth.uid in coupleOf(cid).members; }

    // 두 사람의 연결 정보: 우리 둘만 읽을 수 있음
    match /couples/{cid} {
      allow read: if authed() && request.auth.uid in resource.data.members;
      allow create: if authed()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'a';
      // 초대 코드를 받은 사람이 자기 자신만 'b'로 한 번 추가할 수 있음 (세 번째 사람은 불가)
      allow update: if authed()
        && resource.data.members.size() == 1
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'b'
        && request.resource.data.roles[resource.data.members[0]] == 'a'
        && request.resource.data.roles.keys().hasOnly([resource.data.members[0], request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles', 'joinedAt']);

      // 일정 · 메모 · 표정 · 사진 등: 우리 둘만 읽고 쓸 수 있음
      match /docs/{docId} {
        allow read, write: if isMember(cid);
      }
    }

    // 이메일 초대: 그 이메일로 로그인한 사람만 읽을 수 있음
    match /emailInvites/{email} {
      allow get: if authed() && request.auth.token.email != null && request.auth.token.email.lower() == email;
      allow create: if authed()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in coupleOf(request.resource.data.cid).members;
      allow update: if authed()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in coupleOf(request.resource.data.cid).members;
      allow delete: if authed() && (isMember(resource.data.cid)
        || (request.auth.token.email != null && request.auth.token.email.lower() == email));
    }
  }
}
